# project-green / Apollo — backend (FastAPI) environment.
#
# Copy to `.env` and fill in. The API reads real OS env vars, so either export
# these in your shell or load this file (e.g. `set -a; source .env; set +a`)
# before `uv run uvicorn green.api:app --port 8000`.
#
# EVERYTHING here is optional: with nothing set the API runs fully offline —
# auth off (fixed dev user), runs in memory, and the strategy generator falls
# back to an offline mock. Set keys to go live.

# --- Strategy generator (NL → strategy) -----------------------------------
# Free tier (Apollo Spark → Gemini). This is all you need right now.
# Get a key at https://aistudio.google.com/apikey (no billing required).
GEMINI_API_KEY=

# Optional: override the free model id (defaults to gemini-2.5-flash).
# GREEN_GEMINI_MODEL=gemini-2.5-flash

# --- Databricks Delta market data (production data source) -----------------
# When set, generated real-ticker runs read OHLCV from a Delta table instead of
# Yahoo. From the SQL Warehouse's "Connection details" tab + a personal token.
# GREEN_DATABRICKS_HOST=dbc-xxxx.cloud.databricks.com
# GREEN_DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxx
# GREEN_DATABRICKS_TOKEN=
# GREEN_MARKET_TABLE=apollo_market_ohlcv

# --- MLflow experiment tracking (optional) ---------------------------------
# Log every completed backtest (params, OOS metrics, source) to MLflow. Set to
# "databricks" to use the workspace's MLflow (reuses the Databricks creds above),
# or a file/HTTP store. Unset = no tracking.
# GREEN_MLFLOW_TRACKING_URI=databricks
# GREEN_MLFLOW_EXPERIMENT=/Users/you@email.com/apollo

# Paid tiers (Apollo Core / Prime). Leave blank until you enable them; without
# this key the paid tiers fall back to the offline mock.
# ANTHROPIC_API_KEY=

# Default tier when a request doesn't specify one: free | plus | pro.
# Currently "free" so generations route to Gemini.
# GREEN_DEFAULT_TIER=free

# --- Persistence ----------------------------------------------------------
# memory (ephemeral, default) | sqlite (local durable) | postgres (Supabase).
# Use sqlite for local no-account development; use postgres once your Supabase
# project exists and you have run api/migrations/0001_init.sql.
GREEN_STORE=sqlite
# GREEN_SQLITE_PATH=green.db
# GREEN_STORE=postgres
# GREEN_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-...pooler.supabase.com:6543/postgres

# --- Auth (Supabase) ------------------------------------------------------
# Leave all auth vars unset to keep auth OFF (local dev / offline tests).
#
# Modern Supabase projects: set GREEN_SUPABASE_URL. The API derives:
#   GREEN_JWT_JWKS_URL=$GREEN_SUPABASE_URL/auth/v1/.well-known/jwks.json
#   GREEN_JWT_ISSUER=$GREEN_SUPABASE_URL/auth/v1
#
# Legacy Supabase projects can instead set GREEN_JWT_SECRET for HS256.
# If both are set, GREEN_JWT_SECRET takes precedence.
# GREEN_SUPABASE_URL=https://<project-ref>.supabase.co
# GREEN_JWT_JWKS_URL=
# GREEN_JWT_ISSUER=
# GREEN_JWT_SECRET=
# GREEN_JWT_AUDIENCE=authenticated
# GREEN_DEV_USER_ID=local-dev

# --- CORS -----------------------------------------------------------------
# Comma-separated browser origins allowed to call the API.
# GREEN_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
