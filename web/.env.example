# project-green / Apollo — frontend (Next.js) environment.
# Copy to `.env.local`. NEXT_PUBLIC_* values are exposed to the browser.

# Base URL of the FastAPI backend. Defaults to http://localhost:8000 if unset.
# The WebSocket URL is derived from this automatically.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase browser auth. Leave unset for local dev mode; set both to enable real
# login/signup and have API calls include the user's access token.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
